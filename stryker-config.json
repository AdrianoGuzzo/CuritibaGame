{
  "$schema": "https://raw.githubusercontent.com/stryker-mutator/stryker-net/master/src/Stryker.Core/Stryker.Core/Schemas/stryker-config.schema.json",
  "stryker-config": {
    "project": "Curitiba.Core.csproj",
    "solution": "Curitiba.CI.slnx",
    "test-projects": [
      "Curitiba/Curitiba.Tests/Curitiba.Tests.csproj"
    ],
    "project-info": {
      "name": "github.com/AdrianoGuzzo/Curitiba",
      "module": "Curitiba.Core"
    },
    "reporters": [
      "html",
      "json",
      "progress",
      "cleartext"
    ],
    "mutation-level": "Standard",
    "concurrency": 4,
    "mutate": [
      "BeatEmUp/Fighter.cs",
      "BeatEmUp/Camera2D.cs",
      "BeatEmUp/Combat/*.cs",
      "BeatEmUp/Spawning/WaveManager.cs",
      "BeatEmUp/EnemyAi.cs"
    ],
    "thresholds": {
      "high": 80,
      "low": 60,
      "break": 0
    }
  }
}
