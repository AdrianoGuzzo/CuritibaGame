; Curitiba — editor and analyzer settings.
;
; Deliberately small. The formatting section just writes down the style the codebase already uses,
; so an IDE does not fight it. The analyzer section enables the built-in .NET analyzers at their
; default level and promotes only the handful of rules that catch real defects — the aim is signal,
; not a wall of warnings on a codebase that predates them.

root = true

[*]
charset = utf-8
end_of_line = crlf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{json,tmj,mgcb,yml,yaml}]
indent_size = 2

[*.{csproj,slnx,props,targets,spritefont,resx}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
# ---------------------------------------------------------------- style (matches existing code)
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_indent_case_contents = true
csharp_indent_switch_labels = true
csharp_using_directive_placement = outside_namespace:suggestion
csharp_prefer_braces = when_multiline:silent
csharp_style_var_when_type_is_apparent = true:silent
csharp_style_var_elsewhere = false:silent
csharp_style_expression_bodied_methods = when_on_single_line:silent
csharp_style_expression_bodied_properties = when_on_single_line:silent
dotnet_style_qualification_for_field = false:silent
dotnet_style_qualification_for_property = false:silent
dotnet_style_qualification_for_method = false:silent
dotnet_sort_system_directives_first = false

# ---------------------------------------------------------------- naming
dotnet_naming_rule.types_are_pascal_case.severity = suggestion
dotnet_naming_rule.types_are_pascal_case.symbols = types
dotnet_naming_rule.types_are_pascal_case.style = pascal_case
dotnet_naming_symbols.types.applicable_kinds = class,struct,interface,enum,delegate
dotnet_naming_style.pascal_case.capitalization = pascal_case

dotnet_naming_rule.constants_are_pascal_case.severity = suggestion
dotnet_naming_rule.constants_are_pascal_case.symbols = constants
dotnet_naming_rule.constants_are_pascal_case.style = pascal_case
dotnet_naming_symbols.constants.applicable_kinds = field
dotnet_naming_symbols.constants.required_modifiers = const

# ---------------------------------------------------------------- analyzers: real defects only
# The project sets AnalysisMode=None, so nothing is on unless it is listed here. These are all
# rules where a hit is a bug, not a preference — style and performance suggestions are left off so
# that a warning in this build always means something.

# Always a defect: these stop the build.
dotnet_diagnostic.CA2200.severity = error     ; rethrow that destroys the stack trace
dotnet_diagnostic.CA2011.severity = error     ; property assigned inside its own setter
dotnet_diagnostic.CA2245.severity = error     ; property assigned to itself
dotnet_diagnostic.CA2017.severity = error     ; logging format/argument count mismatch

# Almost always a defect, but worth seeing rather than blocking on.
dotnet_diagnostic.CA2201.severity = warning   ; throwing a reserved exception type
dotnet_diagnostic.CA2215.severity = warning   ; Dispose override that never calls base.Dispose
dotnet_diagnostic.CA1806.severity = warning   ; result of a call ignored (e.g. a bare int.Parse)
dotnet_diagnostic.CA2214.severity = warning   ; virtual call from a constructor

# A real (if minor) leak, and it already has pre-existing hits in the screen classes, so it is a
# suggestion: visible in the IDE, not a build failure. See Curitiba.Tests/README.md.
dotnet_diagnostic.CA1001.severity = suggestion   ; type owns an IDisposable but is not disposable

# ---------------------------------------------------------------- generated code
[**/Resources.Designer.cs]
generated_code = true
dotnet_analyzer_diagnostic.severity = none

[**/DevTools/ImGuiRenderer.cs]
# Vendored from the ImGui.NET sample; kept as-is so it can be re-synced upstream, which means
# the rules above are silenced here explicitly rather than by category.
dotnet_analyzer_diagnostic.severity = none
dotnet_diagnostic.CA2214.severity = none
dotnet_diagnostic.CA2215.severity = none
dotnet_diagnostic.CA1001.severity = none
dotnet_diagnostic.CA1806.severity = none

[**/DevTools/DrawVertDeclaration.cs]
dotnet_analyzer_diagnostic.severity = none
